# Neon PostgreSQL — get this from your Neon dashboard (dev branch)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Auth
AUTH_SECRET="your-secret-here"
# GitHub OAuth
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# Resend
RESEND_API_KEY="your-resend-api-key-here"
RESEND_FROM="DevStash <onboarding@resend.dev>"  # use onboarding@resend.dev for dev; set a verified domain in prod
NEXTAUTH_URL="http://localhost:3000"             # used to build verification email links

# Set to false to bypass email verification (useful in dev without a verified Resend domain)
EMAIL_VERIFICATION_ENABLED=true

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL="your-upstash-redis-rest-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Cloudflare R2 Storage
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_r2_bucket_name"
R2_PUBLIC_URL="https://your_r2_public_url"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# For local dev this is the whsec_… printed by `stripe listen --forward-to
# localhost:3000/api/stripe/webhook`, NOT the dashboard endpoint's secret —
# the CLI mints its own per session.
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_YEARLY="price_..."

# Set to true to enforce Free-plan limits and Pro gating (off during development).
# Note the inverted default vs EMAIL_VERIFICATION_ENABLED: billing must be
# explicitly opted *in*. Anything other than the exact string "true" is off.
BILLING_ENFORCED=false

# ---------------------------------------------------------------------------
# OpenAI — powers the Pro-only AI features (tag suggestions, and more to come).
# Model id lives in src/lib/ai/client.ts (AI_MODEL), not here.
# Absent = AI features return "AI features are not configured." rather than
# throwing, so a deployment without a key still builds and runs.
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."

# ---------------------------------------------------------------------------
# MCP Server keys — set these in your shell profile (~/.zshrc or ~/.zprofile)
# rather than in .env, as they are read by Claude Code at the shell level.
# ---------------------------------------------------------------------------
# NEON_API_KEY="napi_..."        # https://console.neon.tech/app/settings/api-keys
# CONTEXT7_API_KEY="ctx7sk-..."  # https://context7.com
